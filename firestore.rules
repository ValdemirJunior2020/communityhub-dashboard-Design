// C:\Users\Valdemir Goncalves\Downloads\propel-properties-dashboard-saas-ready\propel-properties-dashboard\firestore.rules
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserProfile() {
      return signedIn() && exists(userPath());
    }

    function currentUser() {
      return get(userPath()).data;
    }

    function isActive() {
      return hasUserProfile() && currentUser().status == "active";
    }

    function hasRole(roles) {
      return isActive() && currentUser().role in roles;
    }

    function isSuperAdmin() {
      return hasRole(["superAdmin"]);
    }

    function isAdmin() {
      return hasRole(["superAdmin", "admin"]);
    }

    function isManagerOrAbove() {
      return hasRole(["superAdmin", "admin", "manager"]);
    }

    function canViewDashboard() {
      return hasRole(["superAdmin", "admin", "manager", "maintenance", "viewer"]);
    }

    function canWriteOperations() {
      return hasRole(["superAdmin", "admin", "manager"]);
    }

    function isTenant() {
      return hasRole(["tenant"]);
    }

    function isTenantOwnerByEmail() {
      return isTenant()
        && resource.data.email == request.auth.token.email;
    }

    function isTenantOwnerByUserId() {
      return isTenant()
        && resource.data.userId == request.auth.uid;
    }

    function isTenantPaymentOwner() {
      return isTenant()
        && (
          resource.data.tenantUserId == request.auth.uid
          || resource.data.tenantEmail == request.auth.token.email
          || resource.data.tenantId == currentUser().tenantId
        );
    }

    function isTenantPropertyOwner() {
      return isTenant()
        && (
          resource.data.id == currentUser().propertyId
          || resource.data.propertyId == currentUser().propertyId
        );
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId;

      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if isAdmin();

      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
        );

      allow delete: if isSuperAdmin();
    }

    match /properties/{documentId} {
      allow read: if canViewDashboard()
        || (isTenant() && documentId == currentUser().propertyId);

      allow create, update, delete: if canWriteOperations();
    }

    match /units/{documentId} {
      allow read: if canViewDashboard()
        || (isTenant() && documentId == currentUser().unitId)
        || (isTenant() && resource.data.tenantId == currentUser().tenantId);

      allow create, update, delete: if canWriteOperations();
    }

    match /tenants/{documentId} {
      allow read: if canViewDashboard()
        || (isTenant() && documentId == currentUser().tenantId)
        || isTenantOwnerByEmail()
        || isTenantOwnerByUserId();

      allow create, update, delete: if canWriteOperations();
    }

    match /rentPayments/{documentId} {
      allow read: if canViewDashboard() || isTenantPaymentOwner();

      allow create, update, delete: if canWriteOperations();
    }

    match /receipts/{documentId} {
      allow read: if canViewDashboard()
        || (
          isTenant()
          && (
            resource.data.tenantUserId == request.auth.uid
            || resource.data.tenantEmail == request.auth.token.email
            || resource.data.tenantId == currentUser().tenantId
            || documentId in currentUser().receiptIds
          )
        );

      allow create, update: if canWriteOperations();
      allow delete: if isAdmin();
    }

    match /maintenanceRequests/{documentId} {
      allow read: if canViewDashboard()
        || (
          isTenant()
          && (
            resource.data.tenantId == currentUser().tenantId
            || resource.data.tenantEmail == request.auth.token.email
          )
        );

      allow create: if canWriteOperations()
        || (
          isTenant()
          && request.resource.data.tenantId == currentUser().tenantId
        );

      allow update, delete: if canWriteOperations()
        || (
          hasRole(["maintenance"])
          && resource.data.assignedUserId == request.auth.uid
        );
    }

    match /workOrders/{documentId} {
      allow read: if canViewDashboard();
      allow create, update, delete: if canWriteOperations()
        || (
          hasRole(["maintenance"])
          && resource.data.assignedTo == request.auth.uid
        );
    }

    match /inspections/{documentId} {
      allow read: if canViewDashboard();
      allow create, update, delete: if canWriteOperations();
    }

    match /owners/{documentId} {
      allow read: if canViewDashboard();
      allow create, update, delete: if canWriteOperations();
    }

    match /vendors/{documentId} {
      allow read: if canViewDashboard();
      allow create, update, delete: if canWriteOperations();
    }

    match /documents/{documentId} {
      allow read: if canViewDashboard()
        || (
          isTenant()
          && (
            resource.data.relatedTenantId == currentUser().tenantId
            || resource.data.relatedPropertyId == currentUser().propertyId
          )
        );

      allow create, update, delete: if canWriteOperations();
    }

    match /settings/{documentId} {
      allow read: if canViewDashboard() || isTenant();
      allow create, update, delete: if isAdmin();
    }

    match /auditLogs/{documentId} {
      allow read: if isAdmin();
      allow create: if isManagerOrAbove();
      allow update, delete: if false;
    }
  }
}