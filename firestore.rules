// C:\Users\Valdemir Goncalves\Downloads\propel-properties-dashboard-saas-ready\propel-properties-dashboard\firestore.rules
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserProfile() {
      return signedIn() && exists(userPath());
    }

    function currentUser() {
      return get(userPath()).data;
    }

    function isActive() {
      return hasUserProfile() && currentUser().status == "active";
    }

    function hasRole(roles) {
      return isActive() && currentUser().role in roles;
    }

    function isSuperAdmin() {
      return hasRole(["superAdmin"]);
    }

    function isAdmin() {
      return hasRole(["superAdmin", "admin"]);
    }

    function isManagerOrAbove() {
      return hasRole(["superAdmin", "admin", "manager"]);
    }

    function canViewDashboard() {
      return hasRole(["superAdmin", "admin", "manager", "maintenance", "viewer"]);
    }

    function canWriteOperations() {
      return hasRole(["superAdmin", "admin", "manager"]);
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId;

      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if isAdmin();

      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
        );

      allow delete: if isSuperAdmin();
    }

    match /properties/{documentId} {
      allow read: if canViewDashboard();
      allow create, update, delete: if canWriteOperations();
    }

    match /units/{documentId} {
      allow read: if canViewDashboard();
      allow create, update, delete: if canWriteOperations();
    }

    match /tenants/{documentId} {
      allow read: if canViewDashboard();
      allow create, update, delete: if canWriteOperations();
    }

    match /rentPayments/{documentId} {
      allow read: if canViewDashboard();
      allow create, update, delete: if canWriteOperations();
    }

    match /maintenanceRequests/{documentId} {
      allow read: if canViewDashboard();
      allow create, update, delete: if canWriteOperations()
        || (
          hasRole(["maintenance"])
          && request.resource.data.assignedUserId == request.auth.uid
        );
    }

    match /workOrders/{documentId} {
      allow read: if canViewDashboard();
      allow create, update, delete: if canWriteOperations()
        || (
          hasRole(["maintenance"])
          && request.resource.data.assignedTo == request.auth.uid
        );
    }

    match /inspections/{documentId} {
      allow read: if canViewDashboard();
      allow create, update, delete: if canWriteOperations();
    }

    match /owners/{documentId} {
      allow read: if canViewDashboard();
      allow create, update, delete: if canWriteOperations();
    }

    match /vendors/{documentId} {
      allow read: if canViewDashboard();
      allow create, update, delete: if canWriteOperations();
    }

    match /documents/{documentId} {
      allow read: if canViewDashboard();
      allow create, update, delete: if canWriteOperations();
    }

    match /settings/{documentId} {
      allow read: if canViewDashboard();
      allow create, update, delete: if isAdmin();
    }

    match /auditLogs/{documentId} {
      allow read: if isAdmin();
      allow create: if isManagerOrAbove();
      allow update, delete: if false;
    }
  }
}